# LiaraPilot — copy to .env and fill. NEVER commit .env.
# LLM access is OpenAI-compatible. Leave empty to run fully offline (FakeLLM).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# DEMO_MODE=1 forces FakeLLM + MockDeployer for the entire flow (offline demo, T12).
DEMO_MODE=1

# Deployer selection (T13): mock | liara_api | liara_cli. DEMO_MODE=1 forces mock.
DEPLOYER=mock

# Liara API token — NEVER commit. In production it lives in RAM for one session only;
# it can also be provided per-session through the approve call (never logged either way).
LIARA_API_TOKEN=

# Plan ID needed to CREATE a new app via POST /v1/projects. Values are UNVERIFIED
# (not in the OpenAPI spec) — copy from the Liara console. Without it, existing apps
# can still be deployed but new apps will not be created.
LIARA_PLAN_ID=

# Disk size for disks created via POST /v1/projects/{name}/disks (units UNVERIFIED).
LIARA_DISK_SIZE=1G

# Set to 1 to build+validate every request payload and print it (secrets redacted)
# WITHOUT sending — recommended first step of the first real deploy (T13 dry-run).
LIARA_DRY_RUN=

# The user's Liara API token is NEVER stored in files — it lives in memory for one session only.
