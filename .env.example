# LiaraPilot — copy to .env and fill. NEVER commit .env.
# ---------------------------------------------------------------------------
# LLM access (OpenAI-compatible). Base URL matches the BoxAPI starcoach brief
# sample; the default model is the operator's budget pick (gpt-5.4-mini) — the
# brief's sample model was gpt-6-astra. The only real secret here is
# LLM_API_KEY. Leave LLM_API_KEY empty to run fully offline (FakeLLM fallback).
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini

# Hard cap on real-LLM calls per client/run (T3). FakeLLM/demo is never billed.
LLM_MAX_CALLS=40

# DEMO_MODE=1 forces FakeLLM + MockDeployer for the entire flow (offline demo).
DEMO_MODE=1

# Deployer selection: mock | liara_api | liara_cli. DEMO_MODE=1 forces mock.
DEPLOYER=mock

# Liara API base (VERIFIED from paas.yaml server entry).
LIARA_API_BASE_URL=https://api.liara.ir

# Liara API token — NEVER commit. In production it lives in RAM for one session
# only; it can also be provided per-session through the approve call.
LIARA_API_TOKEN=

# Team context (VERIFIED live 2026-10-22): credit can be TEAM-scoped. Copy the
# «شناسه تیم» from console.liara.ir/API; every request then carries ?teamID=…
# (same mechanism as the official CLI). Leave empty for a personal account.
LIARA_TEAM_ID=

# Plan ID needed to CREATE a new app via POST /v1/projects. Real values come
# from the live catalog GET /v1/me (e.g. small-g2 ≈ 660 Toman/h, ir-small,
# medium-g2, …). Without it, existing apps can still be deployed, new apps
# not created.
LIARA_PLAN_ID=

# Feature-bundle tier sent at app creation (VERIFIED live: one of
# free|basic|standard|pro). Default basic; use "free" only for the free plan.
LIARA_BUNDLE_PLAN_ID=basic

# Network id for app creation (VERIFIED live: POST /v1/projects rejects the
# body without one). Leave empty to auto-discover the first network of the
# account/team (GET /v1/networks); create one via console or
# `liara network create` if none exists.
LIARA_NETWORK_ID=

# Disk size in GB (a NUMBER) for POST /v1/projects/{name}/disks — VERIFIED
# live 2026-10-22: the API rejects strings like "1G" (400 '"size" must be a
# number'); size 1 -> 201 and the app reports reservedDiskSpace 1.
LIARA_DISK_SIZE=1

# `since` query value for GET /v1/projects/{name}/logs — the spec REQUIRES the
# parameter (type string) but does not document its format. UNVERIFIED; adjust
# here if the live API rejects "0".
LIARA_LOGS_SINCE=0

# Set to 1 to build+validate every request payload and print it (redacted)
# WITHOUT sending — recommended first step of the first real deploy.
LIARA_DRY_RUN=

# --- Continuous monitoring (T6) -------------------------------------------
# Health poll interval in seconds while a session is deployed; 0 disables.
MONITOR_INTERVAL_S=30
# Samples kept per session for the short history.
MONITOR_HISTORY_N=30
# Consecutive unhealthy samples before a monitor alert is emitted.
MONITOR_ALERT_AFTER=2

# --- Public deployment protection (A4) --------------------------------------
# Per-IP sliding window + process-wide ceiling. OFF by default for local use;
# ALWAYS set these when deploying the agent to a public URL (e.g. on Liara).
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_GLOBAL_M=600
