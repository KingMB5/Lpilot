# LiaraPilot — copy to .env and fill. NEVER commit .env.
# LLM access is OpenAI-compatible. Leave empty to run fully offline (FakeLLM).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# DEMO_MODE=1 forces FakeLLM + MockDeployer for the entire flow (offline demo, T12).
DEMO_MODE=1

# The user's Liara API token is NEVER stored here — it lives in memory for one session only.
