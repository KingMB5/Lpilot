# LiaraPilot — copy to .env and fill. NEVER commit .env.
# ---------------------------------------------------------------------------
# LLM access (OpenAI-compatible). Defaults match the BoxAPI starcoach brief
# sample (base_url + model gpt-6-astra). The only real secret here is
# LLM_API_KEY. Leave LLM_API_KEY empty to run fully offline (FakeLLM fallback).
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-astra

# Hard cap on real-LLM calls per client/run (T3). FakeLLM/demo is never billed.
LLM_MAX_CALLS=40

# DEMO_MODE=1 forces FakeLLM + MockDeployer for the entire flow (offline demo).
DEMO_MODE=1

# Deployer selection: mock | liara_api | liara_cli. DEMO_MODE=1 forces mock.
DEPLOYER=mock

# Liara API base (VERIFIED from paas.yaml server entry).
LIARA_API_BASE_URL=https://api.liara.ir

# Liara API token — NEVER commit. In production it lives in RAM for one session
# only; it can also be provided per-session through the approve call.
LIARA_API_TOKEN=

# Plan ID needed to CREATE a new app via POST /v1/projects. Values are NOT in
# the OpenAPI spec (no plan-catalog endpoint exists) — copy from the Liara
# console. Without it, existing apps can still be deployed, new apps not created.
LIARA_PLAN_ID=

# Disk size for POST /v1/projects/{name}/disks (body VERIFIED {name, size:string};
# size units UNVERIFIED).
LIARA_DISK_SIZE=1G

# `since` query value for GET /v1/projects/{name}/logs — the spec REQUIRES the
# parameter (type string) but does not document its format. UNVERIFIED; adjust
# here if the live API rejects "0".
LIARA_LOGS_SINCE=0

# Set to 1 to build+validate every request payload and print it (redacted)
# WITHOUT sending — recommended first step of the first real deploy.
LIARA_DRY_RUN=

# --- Continuous monitoring (T6) -------------------------------------------
# Health poll interval in seconds while a session is deployed; 0 disables.
MONITOR_INTERVAL_S=30
# Samples kept per session for the short history.
MONITOR_HISTORY_N=30
# Consecutive unhealthy samples before a monitor alert is emitted.
MONITOR_ALERT_AFTER=2
